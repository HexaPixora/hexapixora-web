{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NODE_ENV",
        "API_URL",
        "API_PROXY_ORIGIN",
        "SITE_URL",
        "SITE_NAME",
        "ADMIN_URL",
        "TURNSTILE_SITE_KEY",
        "PREVIEW_TOKEN",
        "REVALIDATE_SECRET",
        "MAINTENANCE_MODE"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
