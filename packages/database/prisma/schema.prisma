datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// User & Authentication
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  // Null until an INVITED user accepts their invite and sets a password.
  password  String?
  name      String?
  role      Role     @default(TEAM_MEMBER)
  // Account lifecycle: INVITED users can't log in until they accept + set a password.
  status    UserStatus @default(ACTIVE)
  // Section keys this user may access (e.g. ["blogs","media"]). Ignored for
  // ADMIN/SUPER_ADMIN, who have full access. Drives TEAM_MEMBER capabilities.
  permissions String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]
  verificationTokens VerificationToken[]
  pushSubscriptions  PushSubscription[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEAM_MEMBER
}

enum UserStatus {
  ACTIVE
  INVITED
}

// Single-use magic-link tokens for invites, password resets and email changes.
model VerificationToken {
  id        String    @id @default(uuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Target address for EMAIL_CHANGE (the pending new email).
  newEmail  String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum TokenType {
  INVITE
  PASSWORD_RESET
  EMAIL_CHANGE
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}

// ==========================================
// CMS Modules
// ==========================================

model Service {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  icon             String?
  banner           String?
  excerpt          String?
  content          String
  features         Json?    // Array of strings or objects
  faq              Json?    // Array of { question, answer }
  
  // SEO
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  ogImage          String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Portfolio {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  clientName       String?
  industry         String?
  description      String
  challenge        String?
  solution         String?
  results          String?
  technologies     Json?    // Array of strings
  gallery          Json?    // Array of media URLs
  
  // SEO
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  ogImage          String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Publishing lifecycle shared by Page and Blog. DRAFT = not public; SCHEDULED =
// goes live automatically once publishAt passes (a cron flips it to PUBLISHED);
// PUBLISHED = visible on the live site.
enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// Shared content taxonomy. Curated in the admin (distinct from free-form `tags`)
// and referenced by blog posts (many-to-many) and the portfolio module (by name).
model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?  // optional hex for admin/badge tinting
  blogs       Blog[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  excerpt          String?
  categories       Category[]
  tags             Json?    // Array of strings
  thumbnail        String?
  content          String
  publishDate      DateTime?
  isPublished      Boolean  @default(false)
  // Richer publishing state. Kept in sync with isPublished by BlogsService
  // (isPublished stays the canonical public filter). Legacy rows default to
  // DRAFT — backfill once with: UPDATE "Blog" SET status='PUBLISHED' WHERE "isPublished"=true;
  status           ContentStatus @default(DRAFT)
  // When set with status=SCHEDULED, the publish cron makes the post live at this time.
  publishAt        DateTime?
  readTime         Int?     // Minutes to read, auto-calculated
  // Structured FAQ: array of { question, answer } — rendered as an accordion
  // on the post page and emitted as FAQ structured data for search engines.
  faq              Json?

  // SEO
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  ogImage          String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TeamMember {
  id               String   @id @default(uuid())
  name             String
  designation      String
  bio              String?
  image            String?
  linkedinUrl      String?
  githubUrl        String?
  order            Int      @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Faq {
  id               String   @id @default(uuid())
  question         String
  answer           String
  category         String?
  order            Int      @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Media {
  id               String   @id @default(uuid())
  filename         String
  url              String
  mimetype         String
  size             Int
  folder           String?  @default("general")
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==========================================
// Marketing & Leads
// ==========================================

model Lead {
  id               String   @id @default(uuid())
  name             String
  email            String
  phone            String?
  country          String?
  message          String?
  type             String   @default("contact") // contact, consultation, quote
  status           LeadStatus @default(NEW)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model NewsletterSubscriber {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String?
  status           SubscriptionStatus @default(ACTIVE)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

// ==========================================
// Site Settings & Configuration
// ==========================================

model SiteSetting {
  id               String   @id @default("global") // Single row pattern
  siteName         String   @default("HexaPixora")
  tagline          String?
  businessEmail    String?
  businessPhone    String?
  address          String?
  timezone         String?
  googleMapsUrl    String?
  logoUrl          String?
  faviconUrl       String?

  // SEO / social-share defaults (site-wide fallbacks; per-page values override).
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  ogImage          String?

  // Analytics
  googleAnalyticsId String?
  gtmId            String?
  metaPixelId      String?

  // Scheduling / booking — list of meeting types: [{ label, url }] (Calendly etc.)
  bookingLinks     Json     @default("[{\"label\":\"Free Strategy Call\",\"url\":\"https://calendly.com/umairbreet/free-strategy-call\"}]")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LayoutConfig {
  id               String   @id @default(uuid())
  key              String   @unique // 'header', 'footer', 'mega-menu'
  data             Json     // Storing nested configurations
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==========================================
// Custom Pages
// ==========================================

model Page {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  sections         Json     @default("[]") // Array of modules
  showHeader       Boolean  @default(true)
  showFooter       Boolean  @default(true)
  // Exactly one page may be the site home (rendered at "/"). Enforced in the
  // service (setting one clears the others); indexed for the public lookup.
  isHomepage       Boolean  @default(false)
  // Publishing lifecycle. Defaults to PUBLISHED so existing pages stay live
  // after the column is added; new pages may be saved as DRAFT/SCHEDULED.
  status           ContentStatus @default(PUBLISHED)
  // When set with status=SCHEDULED, the publish cron makes the page live at this time.
  publishAt        DateTime?
  metaTitle        String?
  metaDescription  String?
  // Featured / social-share image (Open Graph + Twitter card).
  ogImage          String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isHomepage])
}

// ==========================================
// Admin Notifications (in-app bell feed)
// ==========================================

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String?
  // Admin deep-link to the related record, e.g. "/admin/leads".
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  LEAD
  NEWSLETTER
  SYSTEM
}

// ==========================================
// Newsletter campaigns (send-from-admin)
// ==========================================

model Campaign {
  id             String         @id @default(uuid())
  subject        String
  content        String         // HTML body composed in the admin
  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0)
  sentCount      Int            @default(0)
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([createdAt])
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

// Browser Web Push subscription (one per admin device/browser).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
