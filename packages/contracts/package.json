{
  "name": "@hexapixora/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Content shapes shared by the API, admin and site: block definitions, layout schemas, permissions.",
  "exports": {
    "./blocks/*": "./src/blocks/*.ts",
    "./layout/*": "./src/layout/*.ts",
    "./links": "./src/links.ts",
    "./permissions": "./src/permissions.ts",
    "./countries": "./src/countries.ts",
    "./theme-pack/*": "./src/theme-pack/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "node --import tsx --test src/blocks/legacy/*.test.ts src/theme-pack/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@hexapixora/typescript-config": "*",
    "typescript": "5.9.2",
    "tsx": "^4.22.4"
  }
}
