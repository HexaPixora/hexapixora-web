# The API checks every setting below when it starts. In production
# (NODE_ENV=production) any problem stops the start with the full list; in
# development problems are only logged.

# ── Core ────────────────────────────────────────────────────────────────────
# "production" on the host (the Docker image sets it).
# NODE_ENV=development

# API server port
PORT=3001

# The site's name until Settings → Site name is saved: the name a new site
# starts with and the fallback in emails.
SITE_NAME=My Site

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres connection string (also consumed by packages/database).
DATABASE_URL=postgresql://user:password@localhost:5432/site

# JWT signing secrets — REQUIRED in production: at least 32 characters each and
# different from each other. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── First-admin bootstrap (seed) ─────────────────────────────────────────────
# Used by `npm run db:seed --workspace=@hexapixora/database`. Idempotent.
# Leave the password blank to skip seeding.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# ── Media storage (Supabase Storage — free 1GB) ──────────────────────────────
# When BOTH are set, uploads persist to a PUBLIC Supabase Storage bucket
# (survives redeploys). When unset, media falls back to the local
# ./uploads disk (fine for local dev, but ephemeral on container hosts).
# SUPABASE_URL = https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY = Supabase dashboard → Settings → API → service_role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Public origin of the site — used for public links in emails (unsubscribe,
# blog posts). Set to your live site URL in prod.
APP_URL=http://localhost:3000

# Origin of the admin app — used for account links in emails (password reset,
# email verification). Falls back to APP_URL when unset.
ADMIN_URL=http://localhost:3002

# ── Instant site refresh after content edits ─────────────────────────────────
# Optional: the site's revalidation hook and its shared secret (the site's
# REVALIDATE_SECRET). When unset, edits appear after the pages' cache interval.
SITE_REVALIDATE_URL=http://localhost:3000/hooks/revalidate
REVALIDATE_SECRET=

# ── Web Push (VAPID) — background/desktop push notifications ──────────────────
# Generate a keypair once with: npx web-push generate-vapid-keys
# All optional: with no keys, push is a no-op (the in-app bell still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:); defaults to ADMIN_URL.
VAPID_SUBJECT=mailto:admin@example.com

# ── Transactional email (Resend — free tier) ─────────────────────────────────
# All optional: with no key the MailService no-ops and lead capture still works.
# (Required in prod to actually deliver invites / password-reset / verify links.)
RESEND_API_KEY=
# Defaults to "<SITE_NAME> <onboarding@resend.dev>" (Resend's shared test sender).
MAIL_FROM=My Site <onboarding@resend.dev>
LEADS_NOTIFY_TO=

# ── Spam protection (Cloudflare Turnstile) ───────────────────────────────────
# Optional: when set, incoming lead form submissions must pass Turnstile verification.
TURNSTILE_SECRET_KEY=

# ── Real visitor addresses for rate limits ───────────────────────────────────
# Browser calls arrive through the site's and admin's /api proxy. With this
# secret (the same value in the site and admin), the API counts limits per
# visitor IP the proxies forward; without it, per connection address.
API_PROXY_SECRET=
# Load balancers between the internet and the API (Northflank: 1). 0 = none.
TRUST_PROXY_HOPS=0

# ── Scheduled routines (automation API) ──────────────────────────────────────
# Shared key the routines send as X-Automation-Key. When unset, every
# /api/automation route answers 503.
AUTOMATION_API_KEY=
