# Base URL of the NestJS API, including the /api prefix (server-side fetches
# and the /api/* rewrite target).
API_URL=http://localhost:3001/api
# Browser calls go to the same-origin /api proxy.
NEXT_PUBLIC_API_URL=/api
# Public site the admin manages (for View/Preview links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Maintenance page: auto (default) | on | off
# MAINTENANCE_MODE=auto
#
# PRODUCTION (Vercel admin project):
#   API_URL=<Northflank API URL ending in /api>
#   NEXT_PUBLIC_API_URL=/api
#   NEXT_PUBLIC_SITE_URL=https://hexapixora.com
