# Base URL of the NestJS API, including the /api prefix. Server-only: the
# browser always calls the admin's own /api, which is rewritten to this.
# Read at build time, so redeploy after changing it.
API_URL=http://localhost:3001/api

# Public site the admin manages, for "View page" links.
SITE_URL=http://localhost:3000

# Maintenance page: "auto" (default), "on" or "off".
# MAINTENANCE_MODE=auto

# Production (Vercel project hexapixora-admin):
#   API_URL=https://<api-host>/api
#   SITE_URL=https://hexapixora.com
