# Base URL of the NestJS API, including the /api prefix.
# Used by Server Components / server-side fetches. The /api/* rewrite proxy
# target is derived from this automatically (override with API_PROXY_ORIGIN).
API_URL=http://localhost:3001/api

# Same URL exposed to the browser (client-side axios calls).
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Public base URL of the live site. Used for sitemap/canonical URLs. In production set this to your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maintenance page: "auto" (default) shows it while the API's /health fails,
# "on" forces it for planned work, "off" disables it (handy when running the
# web app without the API locally).
# MAINTENANCE_MODE=auto

# Origin of the admin app. When set, /admin and the account pages (login,
# password reset, email verification) redirect there.
# ADMIN_URL=http://localhost:3002

# Shared secret for POST /hooks/revalidate, which the API calls after content
# edits. Must match the API's REVALIDATE_SECRET.
# REVALIDATE_SECRET=

# Optional: Cloudflare Turnstile anti-spam site key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...

# ---------------------------------------------------------------------------
# PRODUCTION (Vercel) values — set these in the Vercel project, not here.
# See DEPLOY.md. The browser uses a same-origin /api proxy, so cookies/login
# work with no CORS.
#
#   API_URL=https://<api-host>/api   # server fetches + /api proxy target (absolute)
#   NEXT_PUBLIC_API_URL=/api                           # browser → same-origin → proxied to the API
#   NEXT_PUBLIC_SITE_URL=https://hexapixora.com        # live domain (sitemap, canonicals)
#   ADMIN_URL=https://admin.hexapixora.com             # admin + account pages
#   REVALIDATE_SECRET=<random, same as the API>        # instant refresh after edits
#
# Optional — enable the realtime chat widget in production (websockets can't use
# the /api proxy, so point this straight at the API origin):
#   NEXT_PUBLIC_WS_ORIGIN=https://<api-host>
# ---------------------------------------------------------------------------
