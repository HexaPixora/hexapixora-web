# Base URL of the NestJS API, including the /api prefix. Server-only: server
# fetches use it directly and the browser's /api calls are rewritten to it.
# Read at build time for the rewrite, so redeploy after changing it.
API_URL=http://localhost:3001/api

# Public base URL of the live site, for sitemap and canonical URLs. On Vercel it
# defaults to the production domain, so it is optional there.
SITE_URL=http://localhost:3000

# Origin of the admin app. When set, /admin and the account pages (login,
# password reset, email verification) redirect there.
# ADMIN_URL=http://localhost:3002

# Shared secret for POST /hooks/revalidate, which the API calls after content
# edits. Must match the API's REVALIDATE_SECRET.
# REVALIDATE_SECRET=

# Shared secret that lets the API trust the visitor IP this app forwards with
# /api calls (per-visitor rate limits). Must match the API's API_PROXY_SECRET.
# Read at request time.
# API_PROXY_SECRET=

# Maintenance page: "auto" (default) shows it while the API's /health fails,
# "on" forces it for planned work, "off" disables it.
# MAINTENANCE_MODE=auto

# Optional: Cloudflare Turnstile site key for the contact form.
# TURNSTILE_SITE_KEY=0x4AAAAAA...

# Production (Vercel project hexapixora-web):
#   API_URL=https://<api-host>/api
#   API_PROXY_SECRET=<random, same as the API>
#   ADMIN_URL=https://admin.hexapixora.com
#   REVALIDATE_SECRET=<random, same as the API>
#   TURNSTILE_SITE_KEY=<from Cloudflare>
